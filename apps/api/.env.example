# apps/api — variables de entorno (contrato en src/config.ts; falla-cerrado)
# Copiar a .env / configurar en el entorno de despliegue. NUNCA commitear valores reales;
# en Azure los secretos van por Key Vault reference (EXECUTION_PLAN §1.8).

# --- Requeridas (el proceso no arranca sin ellas) ---
# Meta App Secret: HMAC de X-Hub-Signature-256 del webhook.
META_APP_SECRET=
# Token del handshake GET de verificacion del webhook (hub.verify_token).
META_VERIFY_TOKEN=
# Postgres (rol de la API; el portal jamas accede a la BD directo desde el navegador).
DATABASE_URL=postgres://usuario:password@host:5432/proveeduria

# --- Opcionales ---
# Puerto HTTP del ingress (default 8080).
PORT=8080
# 'production' activa la validacion estricta de cola (falla-cerrado sin cola real).
NODE_ENV=development
# Cola de ingesta (Azure Storage Queues). Requerida en production salvo flag explicito.
# OJO: no setear hasta que el consumer real del worker exista (A1 del plan) — hoy el
# stub lanza y cada POST del webhook devolveria 500 (retry storm de Meta).
AZURE_STORAGE_QUEUE_CONNECTION=
AZURE_STORAGE_QUEUE_NAME=ingesta
# Solo dev/test: permite cola en memoria de forma explicita (perdida de jobs al morir).
ALLOW_INMEMORY_QUEUE=

# --- Portal (Centro de Control, docs/specs/control-center.md §Autenticacion) ---
# Secreto HS256 de los JWT de sesion del portal. REQUERIDO en production (falla-cerrado);
# en dev/test, si falta, se genera uno efimero en memoria (no sobrevive un reinicio).
PORTAL_JWT_SECRET=
# Origen exacto habilitado para CORS con credenciales del portal (ej. https://portal.tuapp.cr).
# Si no esta definido, la API no emite headers CORS (solo acceso same-origin).
PORTAL_ORIGIN=

# --- Adjuntos (GET /api/attachments/:id?f=<firma>, docs/specs/outbox-whatsapp.md) ---
# Secreto HS256 COMPARTIDO con apps/worker (mismo valor en ambos) para firmar/verificar el
# link publico que Meta usa para descargar el PDF de OC. REQUERIDO en production
# (falla-cerrado); en dev/test, si falta, se genera uno efimero en memoria.
ATTACHMENTS_LINK_SECRET=
