# apps/worker — variables de entorno (contrato en src/config.ts)
# Copiar a .env / configurar en el entorno de despliegue. NUNCA commitear valores reales;
# en Azure los secretos van por Key Vault reference (EXECUTION_PLAN §1.8).

# Postgres (lock advisory, inbound/outbox, estado). Requerida para el handler de dominio.
DATABASE_URL=postgres://usuario:password@host:5432/proveeduria
# Cadena de conexion de Azure Storage Queues (broker de ingesta). Sin ella el worker cae a
# InMemoryConsumer (solo dev/test) — ver docs/specs/broker-colas.md §Configuracion.
AZURE_STORAGE_QUEUE_CONNECTION=
# Nombre de la cola a consumir. Debe coincidir con AZURE_STORAGE_QUEUE_NAME de apps/api.
WORKER_QUEUE_NAME=ingesta
# Visibility timeout por intento de procesamiento, en segundos (presupuesto de trabajo
# antes de que el mensaje reaparezca en la cola).
WORKER_VISIBILITY_S=120
# Umbral de reintentos (dequeueCount) antes de mandar el mensaje a la cola de veneno
# `<WORKER_QUEUE_NAME>-poison`.
WORKER_MAX_DEQUEUE=5
# Espera entre polls con cola vacia, en ms.
WORKER_POLL_EMPTY_MS=1000
# Modo del dispatcher de outbox. `off` (default): no corre.
# `console` (SOLO dev, requiere DATABASE_URL): loop que marca los mensajes como enviados
# logueandolos y devolviendo un wamid_salida sintetico (console:<uuid>) — NO envia por
# WhatsApp.
# `meta` (requiere DATABASE_URL + META_PHONE_NUMBER_ID + META_ACCESS_TOKEN + PUBLIC_API_URL +
# ATTACHMENTS_LINK_SECRET): envio real contra Meta WhatsApp Cloud API (MetaOutboxSender).
# Falla-cerrado: si falta cualquiera de las cuatro, cargarConfig lanza y el proceso no arranca.
# Ver src/config.ts (OutboxMode), docs/specs/outbox-whatsapp.md y
# docs/PLAN_FASE2A_2B_CONTROL_CENTER.md.
WORKER_OUTBOX_MODE=off
# Intervalo de polling del dispatcher de outbox en ms (aplica con WORKER_OUTBOX_MODE=console|meta).
WORKER_OUTBOX_POLL_MS=2000
# Lease del claim del dispatcher, en segundos: filas `enviando` mas viejas que esto se
# consideran huerfanas (crash a mitad de envio) y son reclamables de nuevo.
OUTBOX_CLAIM_LEASE_S=300
# Tamano del batch que reclama el dispatcher por ciclo.
OUTBOX_BATCH=20

# --- Modo meta: envio real de WhatsApp (docs/specs/outbox-whatsapp.md) ---
# phone_number_id de Meta. Requerida cuando WORKER_OUTBOX_MODE=meta.
META_PHONE_NUMBER_ID=
# Access token de Meta (secreto; Key Vault en Azure). Requerida cuando WORKER_OUTBOX_MODE=meta.
META_ACCESS_TOKEN=
# Base del Graph API de Meta; sobreescribible para tests/staging.
META_GRAPH_URL=https://graph.facebook.com/v23.0
# Base publica de apps/api, para armar el link firmado de un documento enviado por
# outbox_messages.attachment_id (GET /api/attachments/:id?f=<firma>, ver
# docs/specs/outbox-whatsapp.md §Documentos adjuntos). Requerida cuando WORKER_OUTBOX_MODE=meta.
PUBLIC_API_URL=
# Secreto HMAC compartido con apps/api para firmar ese link (mismo valor en ambos servicios;
# Key Vault en Azure). Requerido cuando WORKER_OUTBOX_MODE=meta.
ATTACHMENTS_LINK_SECRET=

# --- Se agregan al cablear cada pieza (ver docs/PLAN_FASE2A_2B_CONTROL_CENTER.md) ---
# A5 loop Claude de produccion:
# ANTHROPIC_API_KEY=
# B5 extraccion de facturas:
# DOCINTEL_ENDPOINT=
# DOCINTEL_API_KEY=
